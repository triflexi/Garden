# Local Docker: http://localhost:8080. On VPS: http://YOUR_PUBLIC_IP and HTTP_PORT=80.
PUBLIC_ORIGIN=http://localhost:8080
HTTP_PORT=8080
POSTGRES_USER=listva
POSTGRES_DB=listva
DB_PASSWORD=replace-with-a-long-random-password
GRAFANA_PASSWORD=replace-with-another-random-password
COOKIE_SECURE=false
TRUST_PROXY=true
# For running the API outside Docker (start the db with compose.dev.yaml):
DB_PORT=15432
DATABASE_URL=postgresql://listva:replace-with-a-long-random-password@localhost:15432/listva?schema=public
